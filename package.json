{
  "name": "hopon",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm -F mobile start",
    "ios": "pnpm -F mobile ios",
    "android": "pnpm -F mobile android",
    "api": "pnpm -F worker dev",
    "api:offline": "pnpm -F worker dev:offline",
    "db:generate": "pnpm -F worker db:generate",
    "db:local": "pnpm -F worker db:local",
    "db:remote": "pnpm -F worker db:remote",
    "deploy": "pnpm -F worker deploy",
    "deploy:staging": "pnpm -F worker deploy:staging",
    "test": "pnpm -r test",
    "check": "oxlint apps packages *.ts *.js && oxfmt --check && pnpm -r typecheck && pnpm -r test",
    "lint": "oxlint apps packages *.ts *.js",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^22.20.2",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^6.0.3",
    "ultracite": "7.12.2"
  },
  "packageManager": "pnpm@12.9.1"
}
