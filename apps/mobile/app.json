{
  "expo": {
    "name": "hopon",
    "slug": "hopon",
    "scheme": "hopon",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1C1D45",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "app.gethopon",
      "deploymentTarget": "17.0",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.gethopon",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1D45"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#1C1D45"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfb076df-dd71-4351-bdc5-0de71dea7e09"
      }
    },
    "owner": "chengchao60827"
  }
}
