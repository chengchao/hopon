{
  "expose": [
    {
      "name": "faceUp",
      "means": "cards face up that are not yet part of a found pair"
    },
    {
      "name": "moves",
      "means": "moves made: one per two cards turned up"
    },
    {
      "name": "found",
      "means": "pairs found"
    }
  ],
  "tests": [
    {
      "name": "tapping a card turns it face up",
      "inputs": [
        {
          "at": 200,
          "type": "tap",
          "x": 58,
          "y": 219
        }
      ],
      "checks": [
        {
          "at": 100,
          "expect": "vars.faceUp === 0 && vars.moves === 0"
        },
        {
          "at": 400,
          "expect": "vars.faceUp === 1 && vars.moves === 0"
        }
      ]
    },
    {
      "name": "a second card makes a move, and a pair that does not match turns back down",
      "inputs": [
        {
          "at": 200,
          "type": "tap",
          "x": 139,
          "y": 300
        },
        {
          "at": 500,
          "type": "tap",
          "x": 221,
          "y": 382
        }
      ],
      "checks": [
        {
          "at": 700,
          "expect": "vars.moves === 1"
        },
        {
          "at": 1800,
          "expect": "vars.moves === 1 && vars.faceUp === 0 && score === vars.found"
        }
      ]
    },
    {
