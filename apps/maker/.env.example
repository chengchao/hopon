# Copy to .env (gitignored); `pnpm -F maker eval` and `pnpm -F maker template` load it.
# Claude (Sonnet and the Opus judge through the AI Gateway on Unified Billing; Haiku through Cloudflare's REST API).
# The token needs AI Gateway Run and Workers AI.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=51a5a41f7bd8425703a6f1d92f867f4d
CLOUDFLARE_GATEWAY_ID=default
# E2B (https://e2b.dev/dashboard, or teamApiKey in ~/.e2b/config.json after `e2b auth login`).
E2B_API_KEY=
# `eval e2e --preview`: the Clerk Development instance's publishable key (as EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY in
# apps/mobile/.env) and the eval user's +clerk_test email.
CLERK_PUBLISHABLE_KEY=
EVAL_CLERK_EMAIL=
