{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hopon",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hopon",
      "database_id": "6be33570-2067-48c6-b716-69e0afb04586",
      "migrations_dir": "migrations",
    },
  ],
  // A Draft's current Revision is drafts/<id>/<n>/ (#117), served by its signed preview links.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "hopon" }],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "secrets": {
    "required": [
      "CLERK_JWT_KEY",
      "CLERK_SECRET_KEY",
      "OPERATOR_PASSWORD",
      "OPERATOR_WEBHOOK_URL",
      // modelFetch's Cloudflare API token (packages/model-fetch), for the Talker's and the Coder's model calls; it needs
      // AI Gateway Run and Workers AI.
      "CLOUDFLARE_API_KEY",
      // The Coder's container gets this one and no other.
      "E2B_API_KEY",
      // Signs a Draft's preview links (#118): HMAC-SHA256 over `draftId.exp`.
      "PREVIEW_SECRET",
    ],
  },
  "vars": {
    // The Talker's model and effort (#116), through modelFetch on the account's gateway.
    "MAKER_TALKER_MODEL": "claude-haiku-5-5",
    "MAKER_TALKER_EFFORT": "high",
    // The Coder's (#116): Haiku 5.5 at low effort.
    "MAKER_CODER_MODEL": "claude-haiku-5-5",
    "MAKER_CODER_EFFORT": "low",
    // A Draft's box is killed after this long with no turn (#144). talker-check shortens it.
    "MAKER_BOX_IDLE_S": "86400",
    // The Talker's abort timer on a build (#116, #122), 30 s more with music: 30 s past the Coder's own deadline, so the
    // Coder reports `failed` first. The Talker test shortens it.
    "MAKER_BUILD_ABORT_S": "150",
    "CLOUDFLARE_ACCOUNT_ID": "51a5a41f7bd8425703a6f1d92f867f4d",
    "CLOUDFLARE_GATEWAY_ID": "default",
  },
  // The Coder (#112, #122): one instance per Draft. max_instances is the global cap on running builds, matching E2B
  // Hobby's 20 running boxes; a deploy waits up to 300 s for a running build.
  "containers": [
    {
      "class_name": "Coder",
      "image": "../maker/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 20,
      "rollout_active_grace_period": 300,
    },
  ],
  // A container needs Docker: `pnpm -F worker dev:coder` runs the Coder locally; plain `dev` and the tests'
  // getPlatformProxy leave it out.
  "dev": { "enable_containers": false },
  // One Talker (src/talker.ts) and one Coder (src/coder.ts) per Draft, each named by the Draft's id.
  "durable_objects": {
    "bindings": [
      { "name": "TALKER", "class_name": "Talker" },
      { "name": "CODER", "class_name": "Coder" },
    ],
  },
  "migrations": [
    { "tag": "talker", "new_sqlite_classes": ["Talker"] },
    { "tag": "coder", "new_sqlite_classes": ["Coder"] },
  ],
  "compatibility_flags": ["nodejs_compat"],
  // Repeated as CLOUDFLARE_ACCOUNT_ID in package.json's db:remote and deploy: on a login with several accounts, some
  // wrangler commands ignore this field when run non-interactively.
  "account_id": "51a5a41f7bd8425703a6f1d92f867f4d",
}
