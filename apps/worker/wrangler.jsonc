{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hopon",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hopon",
      "database_id": "6be33570-2067-48c6-b716-69e0afb04586",
      "migrations_dir": "migrations",
    },
  ],
  // A Draft's current Revision is drafts/<id>/<n>/ (#117), served by its signed preview links.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "hopon" }],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "secrets": {
    "required": [
      "CLERK_JWT_KEY",
      "CLERK_SECRET_KEY",
      "OPERATOR_PASSWORD",
      "OPERATOR_WEBHOOK_URL",
      // modelFetch's Cloudflare API token (packages/model-fetch), for the Maker's model calls; it needs AI Gateway Run and
      // Workers AI.
      "CLOUDFLARE_API_KEY",
      // Signs a Draft's preview links (#118): HMAC-SHA256 over `draftId.exp`.
      "PREVIEW_SECRET",
    ],
  },
  "vars": {
    // The main agent's model and effort (ADR 0005: Opus 5.5), through modelFetch on the account's gateway.
    "MAKER_MAIN_MODEL": "claude-opus-5-5",
    "MAKER_MAIN_EFFORT": "high",
    // The sub agent's: Sonnet 5.5 at high effort, the owner's call on 2026-11-09 (Haiku 5.5 at low effort before, #116).
    "MAKER_SUB_MODEL": "claude-sonnet-5-5",
    "MAKER_SUB_EFFORT": "high",
    // The abort timer on a build's turn (#116, #122): 30 s past the sub agent's own deadline (job.ts), so its job ends
    // `failed` first. The Maker test shortens it.
    "MAKER_BUILD_ABORT_S": "330",
    // Each Creator's weekly Allowance of hopon tokens (ADR 0004): $8 a week, the owner's call on 2026-11-11. A build turn
    // measured about 3,600,000 (ADR 0005), so about 22 a week.
    "MAKER_WEEKLY_TOKENS": "80000000",
    // The oldest iOS build (CFBundleVersion) this Worker still serves: older builds that check show "Please update"
    // (GET /api/version). Raise it when the API drops something a build relies on.
    "MIN_IOS_BUILD": "11",
    "CLOUDFLARE_ACCOUNT_ID": "51a5a41f7bd8425703a6f1d92f867f4d",
    "CLOUDFLARE_GATEWAY_ID": "default",
  },
  // The Maker's sandbox (#175, ADR 0005): one per Draft, which its Maker starts and sizes itself (src/agent-sandbox.ts).
  // No max_instances: the durable_object policy refuses it, and the account's vCPU are the cap.
  "containers": [
    {
      "class_name": "Maker",
      "scheduling_policy": "durable_object",
      "images": {
        "box": {
          "dockerfile": "../maker/image/Dockerfile",
          "build_context": "../maker/image",
        },
      },
    },
  ],
  // A container needs Docker: `pnpm -F worker dev:maker` runs the Maker's sandbox locally; plain `dev` and the tests'
  // getPlatformProxy leave it out, and a build there fails for lack of a box.
  "dev": { "enable_containers": false },
  // The Maker bundles the sub agent's AGENTS.md and skills (apps/maker/agent-home) as text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // One Maker (src/maker.ts) per Draft, named by the Draft's id.
  "durable_objects": {
    "bindings": [{ "name": "MAKER", "class_name": "Maker" }],
  },
  // A Container application can't move to the durable_object policy in place, so the Coder is a new class, DraftCoder,
  // and the old Container class goes: it held nothing durable (#175). It went in two deploys, because Cloudflare refuses
  // to delete a class in the deploy that moves its binding to another class (code 10061): draft-coder added DraftCoder
  // beside an empty Coder (#192), and drop-coder deletes Coder.
  "migrations": [
    { "tag": "talker", "new_sqlite_classes": ["Talker"] },
    { "tag": "coder", "new_sqlite_classes": ["Coder"] },
    { "tag": "draft-coder", "new_sqlite_classes": ["DraftCoder"] },
    // contract: #192
    { "tag": "drop-coder", "deleted_classes": ["Coder"] },
    // ADR 0005: Maker replaces Talker and DraftCoder, which stay as empty classes (src/index.ts) until a later deploy
    // deletes them, for the same reason. Their Drafts' chats aren't kept.
    { "tag": "maker", "new_sqlite_classes": ["Maker"] },
  ],
  "compatibility_flags": ["nodejs_compat"],
  // Prunes past days' and weeks' generation_limits rows (src/storage.ts's pruneLimits).
  "triggers": { "crons": ["0 0 * * *"] },
  // A Worker Preview of the hopon Worker for each branch but main (.github/workflows/deploy.yml runs
  // `pnpm run deploy:preview`). A Preview inherits nothing, so the bindings and vars are repeated, and
  // test/previews.test.js keeps them in step. Each Preview gets its own Maker namespace and its own container app; D1
  // and R2 are hopon-staging, shared by every Preview, and wrangler.preview-migrations.jsonc migrates that D1. Its
  // secrets are the Preview base config's (README).
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "hopon-staging",
        "database_id": "b0cd8575-00b5-4533-93fb-ba6e6e409dda",
        "migrations_dir": "migrations",
      },
    ],
    "r2_buckets": [{ "binding": "FILES", "bucket_name": "hopon-staging" }],
    "ai": { "binding": "AI", "remote": true },
    // No `secrets` here: wrangler 4.152 rejects previews.secrets, so a Preview missing one deploys anyway.
    "vars": {
      "MAKER_MAIN_MODEL": "claude-opus-5-5",
      "MAKER_MAIN_EFFORT": "high",
      "MAKER_SUB_MODEL": "claude-sonnet-5-5",
      // An experiment on the Preview only (ADR 0005): does medium cut the sub agent's first write without worse games?
      "MAKER_SUB_EFFORT": "medium",
      "MAKER_BUILD_ABORT_S": "330",
      "MAKER_WEEKLY_TOKENS": "80000000",
      "MIN_IOS_BUILD": "11",
      "CLOUDFLARE_ACCOUNT_ID": "51a5a41f7bd8425703a6f1d92f867f4d",
      "CLOUDFLARE_GATEWAY_ID": "default",
    },
    // The same box image at the nearest size, but under the default policy: wrangler 4.152–4.154 refuses a
    // durable_object-policy container here ("configured only in the top-level containers array"), and custom sizes are
    // Enterprise-only under default. exec(), setInactivityTimeout() and destroy() work the same; start() takes neither
    // image nor size (src/agent-sandbox.ts). test/previews.test.js keeps it in step with production's box. ponytail: a
    // default-policy app caps instances, and each Draft's box idles 5 min after its build; raise it if `eval e2e
    // --concurrency` builds fail `busy`.
    "containers": [
      {
        "class_name": "Maker",
        "image": "../maker/image/Dockerfile",
        "image_build_context": "../maker/image",
        "instance_type": "standard-3",
        "max_instances": 40,
      },
    ],
    "durable_objects": {
      "bindings": [{ "name": "MAKER", "class_name": "Maker" }],
    },
  },
  // Repeated as CLOUDFLARE_ACCOUNT_ID in package.json's db:remote and deploy: on a login with several accounts, some
  // wrangler commands ignore this field when run non-interactively.
  "account_id": "51a5a41f7bd8425703a6f1d92f867f4d",
}
