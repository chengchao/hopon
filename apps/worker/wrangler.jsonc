{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hopon",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hopon",
      "database_id": "6be33570-2067-48c6-b716-69e0afb04586",
      "migrations_dir": "migrations",
    },
  ],
  // A Draft's current Revision is drafts/<id>/<n>/ (#117), served by its signed preview links.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "hopon" }],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "secrets": {
    "required": [
      "CLERK_JWT_KEY",
      "CLERK_SECRET_KEY",
      "OPERATOR_PASSWORD",
      "OPERATOR_WEBHOOK_URL",
      // modelFetch's Cloudflare API token (packages/model-fetch), for the Talker's and the Coder's model calls; it needs
      // AI Gateway Run and Workers AI.
      "CLOUDFLARE_API_KEY",
      // Signs a Draft's preview links (#118): HMAC-SHA256 over `draftId.exp`.
      "PREVIEW_SECRET",
    ],
  },
  "vars": {
    // The Talker's model and effort (#116), through modelFetch on the account's gateway.
    "MAKER_TALKER_MODEL": "claude-haiku-5-5",
    "MAKER_TALKER_EFFORT": "high",
    // The Coder's (#116): Haiku 5.5 at low effort.
    "MAKER_CODER_MODEL": "claude-haiku-5-5",
    "MAKER_CODER_EFFORT": "low",
    // The Talker's abort timer on a build (#116, #122), 30 s more with music: 30 s past the Coder's own deadline, so the
    // Coder reports `failed` first. The Talker test shortens it.
    "MAKER_BUILD_ABORT_S": "150",
    "CLOUDFLARE_ACCOUNT_ID": "51a5a41f7bd8425703a6f1d92f867f4d",
    "CLOUDFLARE_GATEWAY_ID": "default",
  },
  // The Coder's box (#175): one per Draft, which its Coder starts and sizes itself (src/coder-box.ts). No max_instances:
  // the durable_object policy refuses it, and the account's vCPU are the cap.
  "containers": [
    {
      "class_name": "DraftCoder",
      "scheduling_policy": "durable_object",
      "images": {
        "box": {
          "dockerfile": "../maker/image/Dockerfile",
          "build_context": "../maker/image",
        },
      },
    },
  ],
  // A container needs Docker: `pnpm -F worker dev:coder` runs the Coder's box locally; plain `dev` and the tests'
  // getPlatformProxy leave it out, and a build there fails for lack of a box.
  "dev": { "enable_containers": false },
  // The Coder bundles the Coder's AGENTS.md and skills (apps/maker/agent-home) as text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // One Talker (src/talker.ts) and one Coder (src/coder.ts) per Draft, each named by the Draft's id.
  "durable_objects": {
    "bindings": [
      { "name": "TALKER", "class_name": "Talker" },
      { "name": "CODER", "class_name": "DraftCoder" },
    ],
  },
  // A Container application can't move to the durable_object policy in place, so the Coder is a new class, DraftCoder,
  // and the old Container class goes: it held nothing durable (#175). It goes in two deploys, because Cloudflare refuses
  // to delete a class in the deploy that moves its binding to another class: this one adds DraftCoder and leaves an
  // empty Coder (src/index.ts); the next deletes Coder. Delete its container app (`wrangler containers delete`) first.
  "migrations": [
    { "tag": "talker", "new_sqlite_classes": ["Talker"] },
    { "tag": "coder", "new_sqlite_classes": ["Coder"] },
    { "tag": "draft-coder", "new_sqlite_classes": ["DraftCoder"] },
  ],
  "compatibility_flags": ["nodejs_compat"],
  // A Worker Preview of the hopon Worker for each branch but main (.github/workflows/deploy.yml runs
  // `pnpm run deploy:preview`). A Preview inherits nothing, so the bindings and vars are repeated, and
  // test/previews.test.js keeps them in step. Each Preview gets its own Talker and Coder namespaces and its own container
  // app; D1 and R2 are hopon-staging, shared by every Preview, and wrangler.preview-migrations.jsonc migrates that D1.
  // Its secrets are the Preview base config's (README).
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "hopon-staging",
        "database_id": "b0cd8575-00b5-4533-93fb-ba6e6e409dda",
        "migrations_dir": "migrations",
      },
    ],
    "r2_buckets": [{ "binding": "FILES", "bucket_name": "hopon-staging" }],
    "ai": { "binding": "AI", "remote": true },
    // No `secrets` here: wrangler 4.152 rejects previews.secrets, so a Preview missing one deploys anyway.
    "vars": {
      "MAKER_TALKER_MODEL": "claude-haiku-5-5",
      "MAKER_TALKER_EFFORT": "high",
      "MAKER_CODER_MODEL": "claude-haiku-5-5",
      "MAKER_CODER_EFFORT": "low",
      "MAKER_BUILD_ABORT_S": "150",
      "CLOUDFLARE_ACCOUNT_ID": "51a5a41f7bd8425703a6f1d92f867f4d",
      "CLOUDFLARE_GATEWAY_ID": "default",
    },
    // The same box image at the nearest size, but under the default policy: wrangler 4.152–4.154 refuses a
    // durable_object-policy container here ("configured only in the top-level containers array"), and custom sizes are
    // Enterprise-only under default. exec(), setInactivityTimeout() and destroy() work the same; start() takes neither
    // image nor size (src/coder-box.ts). test/previews.test.js keeps it in step with production's box. ponytail: a
    // default-policy app caps instances, and each Draft's box idles 5 min after its build; raise it if `eval e2e
    // --concurrency` builds fail `busy`.
    "containers": [
      {
        "class_name": "DraftCoder",
        "image": "../maker/image/Dockerfile",
        "image_build_context": "../maker/image",
        "instance_type": "standard-3",
        "max_instances": 40,
      },
    ],
    "durable_objects": {
      "bindings": [
        { "name": "TALKER", "class_name": "Talker" },
        { "name": "CODER", "class_name": "DraftCoder" },
      ],
    },
  },
  // Repeated as CLOUDFLARE_ACCOUNT_ID in package.json's db:remote and deploy: on a login with several accounts, some
  // wrangler commands ignore this field when run non-interactively.
  "account_id": "51a5a41f7bd8425703a6f1d92f867f4d",
}
