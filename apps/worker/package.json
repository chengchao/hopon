{
  "name": "worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "dev:coder": "wrangler dev --enable-containers --var CODER_DEV:1 --ip 0.0.0.0",
    "smoke:coder": "node scripts/coder-smoke.mjs",
    "games-to-r2": "node scripts/games-to-r2.mjs",
    "dev:offline": "wrangler dev --local --ip 0.0.0.0 --var HOPON_OFFLINE:1",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "CLOUDFLARE_ACCOUNT_ID=51a5a41f7bd8425703a6f1d92f867f4d wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm -F maker template && pnpm db:remote && CLOUDFLARE_ACCOUNT_ID=51a5a41f7bd8425703a6f1d92f867f4d wrangler deploy",
    "deploy:preview": "MAKER_E2B_TEMPLATE=hopon-maker-preview pnpm -F maker template && CLOUDFLARE_ACCOUNT_ID=51a5a41f7bd8425703a6f1d92f867f4d wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc && CLOUDFLARE_ACCOUNT_ID=51a5a41f7bd8425703a6f1d92f867f4d wrangler preview",
    "test": "node --test \"test/*.test.js\"",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.22.0",
    "@cloudflare/containers": "0.3.7",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@hopon/model-fetch": "workspace:*",
    "@hopon/schemas": "workspace:*",
    "agents": "0.28.1",
    "drizzle-orm": "^0.45.3",
    "effect": "^4.0.1",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.152.0"
  }
}
