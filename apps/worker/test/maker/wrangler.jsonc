// test/maker.test.js runs `wrangler dev` with this: the Worker's bindings, with test/maker/worker.ts's fake sandbox in
// place of the Container and its scripted model in place of the gateway, a 30 s abort timer for builds (60 s with
// music), and an Allowance of 100 main agent calls. No Docker, no key, no model call.
{
  "name": "hopon-maker-test",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hopon",
      "database_id": "local",
      "migrations_dir": "../../migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "hopon" }],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": {
    "MAKER_MAIN_MODEL": "claude-haiku-5-5",
    "MAKER_MAIN_EFFORT": "high",
    "MAKER_SUB_MODEL": "claude-haiku-5-5",
    "MAKER_SUB_EFFORT": "low",
    "CLOUDFLARE_ACCOUNT_ID": "test",
    "CLOUDFLARE_GATEWAY_ID": "default",
    "HOPON_OFFLINE": "1",
    "MAKER_BUILD_ABORT_S": "30",
    "MAKER_WEEKLY_TOKENS": "100000",
    // /__maker/<draftId>/<path> reaches the Draft's Maker, as under dev:maker.
    "MAKER_DEV": "1",
  },
  "durable_objects": {
    "bindings": [{ "name": "MAKER", "class_name": "Maker" }],
  },
  "migrations": [{ "tag": "maker", "new_sqlite_classes": ["Maker"] }],
}
